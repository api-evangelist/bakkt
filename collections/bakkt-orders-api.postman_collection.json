              "raw": "{\n  \"symbol\": \"<string>\",\n  \"clientOrderId\": \"<string>\",\n  \"type\": \"<string>\",\n  \"timeInForce\": \"<string>\",\n  \"account\": \"<string>\",\n  \"side\": \"<string>\",\n  \"bpsCommission\": \"<integer>\",\n  \"bpsMarkup\": \"<integer>\",\n  \"expireTime\": \"<dateTime>\",\n  \"fixedCommission\": \"<string>\",\n  \"fixedMarkup\": \"<string>\",\n  \"notional\": \"<string>\",\n  \"price\": \"<string>\",\n  \"quantity\": \"<string>\",\n  \"stopPrice\": \"<string>\"\n}",
